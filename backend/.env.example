# Local development environment variables
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tickerTap
JWT_SECRET=please-change-me

# Shared secret for the internal news ingestion API (Server B → Server A)
# Generate with: openssl rand -hex 32
INTERNAL_NEWS_KEY=please-change-me
# News worker (same compose) reads this key as TICKERTAP_INTERNAL_KEY fallback.
# Score on the GPU Ollama host — NEWS_OLLAMA_MODEL defaults to hermes3:8b.
NEWS_OLLAMA_MODEL=hermes3:8b

# Shared secret for the Kamilo AI assistant's read-only finance API
# (GET /internal/portfolio/kamilo/*). Separate from INTERNAL_NEWS_KEY.
KAMILO_SERVICE_KEY=please-change-me

# Soft-stop push channels (Telegram primary, ntfy backup). Token stays local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=https://ntfy.kamilonet.win
NTFY_TOPIC=tickertap-alerts
NTFY_TOKEN=

# SEC Form 4 poller (trading-worker). Must include a contact email or the job no-ops.
SEC_USER_AGENT=TickerTap secedgar@ticker-tap.com
