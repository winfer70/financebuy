# Production environment variables
# Copy this file to .env.prod and fill in the values before deploying.
# NEVER commit .env.prod to version control.

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing secret — use a long random string
# Generate one with: openssl rand -hex 64
JWT_SECRET=change_me_long_random_secret

# Comma-separated list of allowed CORS origins (your frontend URL)
ALLOWED_ORIGINS=https://ticker-tap.com

# Shared secret for the internal news ingestion API (Server B → Server A)
# Generate with: openssl rand -hex 32
INTERNAL_NEWS_KEY=change_me_long_random_secret
NEWS_OLLAMA_MODEL=hermes3:8b

# Soft-stop push channels — token only on the server, never commit it
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=https://ntfy.kamilonet.win
NTFY_TOPIC=tickertap-alerts
NTFY_TOKEN=

# SEC Form 4 poller — required contact email in User-Agent or the job no-ops.
SEC_USER_AGENT=
