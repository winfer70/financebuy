# Production environment variables
# Copy this file to .env.prod and fill in the values before deploying.
# NEVER commit .env.prod to version control.

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing secret — use a long random string
# Generate one with: openssl rand -hex 64
JWT_SECRET=change_me_long_random_secret

# Comma-separated list of allowed CORS origins (your frontend URL)
ALLOWED_ORIGINS=https://ticker-tap.com

# Shared secret for the internal news ingestion API (Server B → Server A)
# Generate with: openssl rand -hex 32
INTERNAL_NEWS_KEY=change_me_long_random_secret
NEWS_OLLAMA_MODEL=hermes3:8b

# Shared secret for the Kamilo AI assistant's read-only finance API
# (GET /internal/portfolio/kamilo/*). Separate from INTERNAL_NEWS_KEY so
# rotating one never affects the other. Generate with: openssl rand -hex 32
KAMILO_SERVICE_KEY=change_me_long_random_secret

# Soft-stop push channels — token only on the server, never commit it
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public @username of the same bot (not a secret) — shown to users who
# register via a Telegram invite link so they know who to message.
TELEGRAM_BOT_USERNAME=

# Bot -> API auth for backend/app/telegram_bot/bot.py (commands + internal
# Telegram-link endpoint). BOT_USER_ID is the owner's own account, used for
# /analyze, /buy, /sell etc. — generate BOT_API_KEY with: openssl rand -hex 32
BOT_API_KEY=change_me_long_random_secret
BOT_USER_ID=
AI_PAPER_PORTFOLIO_ID=
NTFY_URL=https://ntfy.kamilonet.win
NTFY_TOPIC=tickertap-alerts
NTFY_TOKEN=

# SEC Form 4 poller — required contact email in User-Agent or the job no-ops.
SEC_USER_AGENT=TickerTap secedgar@ticker-tap.com
